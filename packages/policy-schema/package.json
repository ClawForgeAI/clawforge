{
  "name": "@clawforgeai/policy-schema",
  "version": "0.0.0",
  "private": true,
  "description": "Vendored AGT policy schema with Zod validators and YAML I/O for ClawForge.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./schema.json": "./src/policy_schema.json"
  },
  "files": [
    "dist/",
    "src/policy_schema.json"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@microsoft/agent-governance-sdk": "^3.7.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
