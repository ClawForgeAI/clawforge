{
  "name": "@clawforgeai/policy-engine",
  "version": "0.0.0",
  "private": true,
  "description": "Pure policy evaluator, kill switch, and scope resolution for ClawForge.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clawforgeai/contracts": "workspace:*",
    "@clawforgeai/policy-schema": "workspace:*",
    "@clawforgeai/tool-governance": "workspace:*",
    "@microsoft/agent-governance-sdk": "^3.7.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
