  "dependencies": {
    "@clawforgeai/contracts": "workspace:*",
    "jose": "^6.2.4"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
