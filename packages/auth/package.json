{
  "name": "@clawforgeai/auth",
  "version": "0.0.0",
  "private": true,
  "description": "Identity types, session/JWT helpers, and API key parsing for ClawForge.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
