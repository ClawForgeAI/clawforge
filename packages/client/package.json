{
  "name": "@clawforgeai/client",
  "version": "0.0.0",
  "private": true,
  "description": "Customer-facing SDK that wires AGT extension hooks to the ClawForge control plane.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clawforgeai/policy-engine": "workspace:*",
    "@clawforgeai/policy-schema": "workspace:*",
    "@microsoft/agent-governance-sdk": "^3.7.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@vitest/coverage-v8": "^4.1.8",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
