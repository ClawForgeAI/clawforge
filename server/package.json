{
  "name": "@ClawForgeAI/clawforge-server",
  "version": "0.1.0",
  "private": true,
  "description": "ClawForge control plane – admin API and web console for enterprise governance",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node --env-file=.env dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "tsx --env-file=.env ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "db:migrate:drizzle": "tsx --env-file=.env ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:seed": "tsx --env-file=.env src/db/seed.ts",
    "db:studio": "tsx --env-file=.env ./node_modules/drizzle-kit/bin.cjs studio"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.1",
    "fastify": "^5.8.4",
    "jose": "^6.0.11",
    "postgres": "^3.4.5",
    "prom-client": "^15.1.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.12.0",
    "@vitest/coverage-v8": "^4.0.18",
    "drizzle-kit": "^0.31.9",
    "esbuild": "^0.27.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  }
}
